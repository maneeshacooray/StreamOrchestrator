<Window x:Class="StreamOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamOrchestrator"
        mc:Ignorable="d"
        Title="StreamOrchestrator" Height="560" Width="640"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="76" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,8,0" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Header">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Stream URL + playback -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
            <Button DockPanel.Dock="Right" x:Name="PlayButton" Content="Play" Click="PlayButton_Click" />
            <TextBlock DockPanel.Dock="Left" Text="RTSP URL" Style="{StaticResource Label}" />
            <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" Padding="6,4" Text="rtsp://" />
        </DockPanel>

        <!-- Display selection -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="RefreshDisplaysButton" Content="↻" Click="RefreshDisplaysButton_Click"
                    ToolTip="Re-scan displays" MinWidth="34" />
            <TextBlock DockPanel.Dock="Left" Text="Stream on" Style="{StaticResource Label}" />
            <ComboBox x:Name="MonitorCombo" VerticalContentAlignment="Center" Padding="6,4" />
        </DockPanel>

        <!-- Orchestration actions -->
        <StackPanel Grid.Row="2" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="MoveButton" Content="Move stream ⇄" Click="MoveButton_Click"
                        ToolTip="Send the stream to the other display (swaps with what's there)"
                        IsEnabled="False" MinWidth="120" Margin="0,0,0,0" />
                <Button x:Name="SwapButton" Content="Swap displays ⇄" Click="SwapButton_Click"
                        ToolTip="Exchange the contents of the two displays"
                        IsEnabled="False" MinWidth="120" />
                <CheckBox x:Name="OnTopCheck" Content="Keep stream on top" Foreground="#CCCCCC"
                          VerticalAlignment="Center" Margin="14,0,0,0" Click="OnTopCheck_Click" />
            </StackPanel>
            <TextBlock Foreground="#777" Margin="2,8,0,0"
                       Text="Hotkeys:  Ctrl+Alt+S swap displays   •   Ctrl+Alt+M move stream   •   Ctrl+Alt+T toggle on-top" />
        </StackPanel>

        <!-- Detected windows header -->
        <DockPanel Grid.Row="3" Margin="0,0,0,6" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="RefreshWindowsButton" Content="Refresh" Click="RefreshWindowsButton_Click" />
            <TextBlock Text="Presentation windows" Style="{StaticResource Header}" VerticalAlignment="Center" />
        </DockPanel>

        <!-- Detected windows list -->
        <Border Grid.Row="4" BorderBrush="#333" BorderThickness="1" Background="#252526">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="WindowList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="6,4" LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="→ D2" Tag="1" Click="SendWindow_Click" MinWidth="48" />
                                <Button DockPanel.Dock="Right" Content="→ D1" Tag="0" Click="SendWindow_Click" MinWidth="48" />
                                <TextBlock Text="{Binding Title}" Foreground="#DDDDDD" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Status -->
        <TextBlock Grid.Row="5" x:Name="StatusText" Foreground="#9E9E9E" Margin="0,8,0,0" Text="Ready." />
    </Grid>
</Window>
