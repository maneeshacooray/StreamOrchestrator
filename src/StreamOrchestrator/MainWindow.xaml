<Window x:Class="StreamOrchestrator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StreamOrchestrator"
        mc:Ignorable="d"
        Title="StreamOrchestrator" Height="320" Width="560"
        Background="#1E1E1E">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Label">
            <Setter Property="Foreground" Value="#CCCCCC" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="2,0,8,0" />
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Stream URL + playback -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="StopButton" Content="Stop" Click="StopButton_Click" IsEnabled="False" />
            <Button DockPanel.Dock="Right" x:Name="PlayButton" Content="Play" Click="PlayButton_Click" />
            <TextBlock DockPanel.Dock="Left" Text="RTSP URL" Style="{StaticResource Label}" />
            <TextBox x:Name="UrlBox" VerticalContentAlignment="Center" Padding="6,4" Text="rtsp://" />
        </DockPanel>

        <!-- Display selection + move -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
            <Button DockPanel.Dock="Right" x:Name="MoveButton" Content="Move ⇄" Click="MoveButton_Click"
                    ToolTip="Move the stream to the other display" IsEnabled="False" MinWidth="90" />
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="↻" Click="RefreshButton_Click"
                    ToolTip="Re-scan displays" MinWidth="36" />
            <TextBlock DockPanel.Dock="Left" Text="Display" Style="{StaticResource Label}" />
            <ComboBox x:Name="MonitorCombo" VerticalContentAlignment="Center" Padding="6,4" />
        </DockPanel>

        <TextBlock Grid.Row="2" Foreground="#777" TextWrapping="Wrap"
                   Text="The stream plays fullscreen on the selected display. Use Move ⇄ to send it to the other screen." />

        <!-- Status -->
        <TextBlock Grid.Row="4" x:Name="StatusText" Foreground="#9E9E9E" Margin="0,8,0,0" Text="Ready." />
    </Grid>
</Window>
